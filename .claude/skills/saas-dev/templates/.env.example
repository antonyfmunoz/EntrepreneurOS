# SaaS Dev Skill — Environment Variables
# Copy to your project root as `.env` and fill in values.
# All keys consumed via lib/env.ts — never read directly elsewhere.

# ─── Anthropic (required) ─────────────────────────────────────────────────────
# Used by: spec-parser, react-gen, code-integrator, backend-wirer
# Either ANTHROPIC_API_KEY or AI_INTEGRATIONS_ANTHROPIC_API_KEY works.
ANTHROPIC_API_KEY=sk-ant-...
# Optional override for proxy/gateway routing (defaults to https://api.anthropic.com)
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL=

# ─── Neon Postgres (required for orchestrator state + design memory) ─────────
# Pipeline state (pipeline_runs, pipeline_pages) and design memory (dm_*) tables.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ─── Gemini (optional — enables vision review) ──────────────────────────────
# When unset, the pipeline falls back to Claude-only review.
GEMINI_API_KEY=
